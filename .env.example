# Copy to .env (mode 600) and adjust. docker compose reads it from this directory.
# Nothing in this file is a secret: the GitHub credential never goes here (see scripts/register.sh).

# The host directory that holds the warm build cache. It is bind-mounted into the k3s node at
# /var/lib/ci-cache; each cache claim uses one subdirectory (manifests/cache.yaml uses "default").
# Create it before the first `up`, owned by the runner's uid and gid 1001:
#   sudo install -d -o 1001 -g 1001 -m 750 /path/to/ci-cache/default
# On ZFS, put it on a dataset without a snapshot task: it is a cache, and build churn makes
# snapshots large.
CACHE_DIR=/path/to/ci-cache

# The sizing below (the four K3S_CPUS, K3S_MEMORY and K3S_*_RESERVED lines) is an example for a host
# with 16 CPUs and 32 GiB that gives CI 10 CPUs and 17 GiB. On any other host, replace those four
# lines with the ones preflight.sh prints for your budget, for example:
#   BUDGET_CPUS=4 BUDGET_GIB=8 scripts/preflight.sh
#
# Hard caps for the whole cluster (the k3s container and every pod inside it). Docker enforces
# them as cpu.max and memory.max on the container's cgroup. See README, "Sizing". K3S_CPUS may not
# exceed the host's CPU count: Docker refuses to start the container.
K3S_CPUS=10
K3S_MEMORY=17g
# Relative CPU weight against the host's other containers when the CPU is contended (1024 is
# Docker's default; 256 maps to cgroup v2 cpu.weight 35 against the default 100).
K3S_CPU_SHARES=256
K3S_PIDS_LIMIT=32768

# What the kubelet subtracts from the node's capacity before admitting pods. The kubelet sees the
# whole host, not the caps above, so these reservations are what keep pod requests inside the
# caps. Example for a host whose kubelet reports 16 CPUs and 32 GiB:
#   allocatable = capacity - system-reserved - kube-reserved   (k3s sets no memory eviction threshold)
#               = 16 - 6.5 - 0.5 = 9 CPUs and 32768 - 17664 - 1536 = 13568Mi (about 13.25 GiB)
# Recompute both for your host from what preflight.sh prints (the kubelet's memory capacity is
# the kernel's MemTotal, a little less than the installed RAM).
K3S_SYSTEM_RESERVED=cpu=6500m,memory=17664Mi
K3S_KUBE_RESERVED=cpu=500m,memory=1536Mi

# containerd's snapshotter. overlayfs is the default and the fast one; native is the fallback
# when the kubelet or containerd cannot use overlayfs on your storage (README, "Troubleshooting").
K3S_SNAPSHOTTER=overlayfs

# Extra k3s server flags, space-separated, for example --secrets-encryption. Empty by default.
# --protect-kernel-defaults does not keep the host's kernel settings: with it, the kubelet refuses
# to start unless they already have the values it wants (README, "Security posture").
K3S_EXTRA_ARGS=
